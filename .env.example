# Ponnangai POS Environment Variables

# Database Connection String
# -------------------------------------------------------------
# 1. Supabase Connection Pooler (RECOMMENDED - Session Mode port 5432):
#    Works across IPv4, Docker, local dev, and production servers.
#    Example:
#    DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
#
# 2. Supabase Direct Connection (Requires IPv6 or Supabase IPv4 Add-on):
#    DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# 3. Local SQLite Development / Testing:
#    DATABASE_URL=sqlite:///./test.db
#
# NOTE: If your Supabase password has special characters like '@', '#', or '%',
# make sure to URL-encode them (e.g. '@' becomes '%40', '#' becomes '%23').
DATABASE_URL=sqlite:///./test.db

# Secret key for session signing and CSRF tokens
# Run `python -c "import secrets; print(secrets.token_urlsafe(32))"` to generate a secure key
SECRET_KEY=change_this_to_a_secure_random_string

# Set to True for production (enables secure cookies)
PRODUCTION=False
