# Ponnangai POS Environment Variables

# Database Connection String
# Example: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=sqlite:///./test.db

# Secret key for session signing and CSRF tokens
# Run `python -c "import secrets; print(secrets.token_urlsafe(32))"` to generate a secure key
SECRET_KEY=change_this_to_a_secure_random_string

# Set to True for production (enables secure cookies)
PRODUCTION=False
